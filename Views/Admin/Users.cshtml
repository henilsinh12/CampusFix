@model List<(ApplicationUser User, string Role)>
@{ ViewData["Title"] = "Users"; }
<div class="page-heading"><div><span class="eyebrow">ADMINISTRATION</span><h1>User management</h1><p class="text-secondary mb-0">Promote registered accounts to maintenance staff when required.</p></div></div>
<div class="content-card mt-4"><div class="alert alert-info">New accounts register as Students. Assign the Staff role to maintenance team accounts here.</div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Current role</th><th>Change role</th></tr></thead><tbody>@foreach(var row in Model){<tr><td><strong>@row.User.FullName</strong></td><td>@row.User.Email</td><td><span class="status status-@(row.Role.ToLowerInvariant())">@row.Role</span></td><td><form asp-action="SetRole" method="post" class="d-flex gap-2"><input type="hidden" name="userId" value="@row.User.Id" /><select name="role" class="form-select form-select-sm" style="max-width:150px"><option selected="@(row.Role=="Student")">Student</option><option selected="@(row.Role=="Staff")">Staff</option><option selected="@(row.Role=="Admin")">Admin</option></select><button class="btn btn-sm btn-dark">Save</button></form></td></tr>}</tbody></table></div></div>
