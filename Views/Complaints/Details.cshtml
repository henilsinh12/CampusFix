@model Complaint
@{ ViewData["Title"] = "Complaint details"; }
<div class="page-heading"><div><span class="eyebrow">@Model.ReferenceNumber</span><h1>@Model.Title</h1><p class="text-secondary mb-0">Submitted @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p></div><a asp-action="Index" class="btn btn-light">← All complaints</a></div>
<div class="row g-4 mt-1"><div class="col-lg-8"><div class="content-card mb-4"><div class="section-heading"><h4>Issue details</h4><span class="status status-@Model.Status.ToLowerInvariant().Replace(" ", "-")">@Model.Status</span></div><div class="detail-grid"><div><span class="detail-label">Category</span><strong>@Model.Category?.Name</strong></div><div><span class="detail-label">Priority</span><span class="priority priority-@Model.Priority.ToLowerInvariant()">@Model.Priority</span></div><div><span class="detail-label">Location</span><strong>@Model.Location</strong></div><div><span class="detail-label">Reported by</span><strong>@Model.Student?.FullName</strong></div><div class="detail-wide"><span class="detail-label">Description</span><p class="mb-0 preserve-lines">@Model.Description</p></div>@if(!string.IsNullOrWhiteSpace(Model.ResolutionNotes)){<div class="detail-wide"><span class="detail-label">Resolution notes</span><p class="mb-0">@Model.ResolutionNotes</p></div>}</div>
<div class="d-flex flex-wrap gap-2 mt-4">@if((User.IsInRole("Student") && Model.StudentId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && Model.Status == "Pending") || User.IsInRole("Admin")){<a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Id">Edit complaint</a><form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this complaint?"><button class="btn btn-outline-danger">Delete</button></form>}</div>
</div>
@if(User.IsInRole("Admin") || User.IsInRole("Staff")){<div class="content-card mb-4"><h4>Update progress</h4><p class="text-secondary">Record the current status and resolution notes.</p><form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post"><div class="row g-3"><div class="col-md-5"><label class="form-label">Status</label><select name="status" class="form-select">@foreach(var s in new[]{"Pending","In Progress","Resolved","Rejected"}){<option selected="@(Model.Status == s)" value="@s">@s</option>}</select></div><div class="col-md-7"><label class="form-label">Resolution notes</label><input name="resolutionNotes" value="@Model.ResolutionNotes" class="form-control" placeholder="Optional notes" maxlength="1000" /></div></div><button class="btn btn-accent mt-3">Update status</button></form></div>}
@if(User.IsInRole("Admin")){<div class="content-card mb-4"><h4>Assign maintenance staff</h4><form asp-action="AssignStaff" asp-route-id="@Model.Id" method="post"><div class="d-flex gap-2"><select class="form-select" name="staffId"><option value="">Unassigned</option>@foreach(var staff in (IEnumerable<ApplicationUser>)ViewBag.StaffUsers ?? Enumerable.Empty<ApplicationUser>()){<option selected="@(Model.AssignedStaffId == staff.Id)" value="@staff.Id">@staff.FullName (@staff.Email)</option>}</select><button class="btn btn-dark">Assign</button></div></form></div>}
</div>
<div class="col-lg-4"><div class="content-card"><h4>Activity history</h4><div class="timeline">@foreach(var h in Model.StatusHistory.OrderByDescending(h=>h.ChangedAt)){<div class="timeline-item"><span class="timeline-dot"></span><div><strong>@h.NewStatus</strong><p class="small text-secondary mb-1">@h.ChangedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>@if(!string.IsNullOrWhiteSpace(h.Note)){<p class="small mb-0">@h.Note</p>}</div></div>}</div></div></div></div>
