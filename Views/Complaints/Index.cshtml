@model IEnumerable<Complaint>
@{ ViewData["Title"] = "Complaints"; }
<div class="page-heading"><div><span class="eyebrow">REQUEST CENTRE</span><h1>Complaints</h1><p class="text-secondary mb-0">Search and track maintenance requests.</p></div>@if (User.IsInRole("Student") || User.IsInRole("Admin")) { <a class="btn btn-accent" asp-action="Create">＋ New complaint</a> }</div>
<div class="content-card mt-4">
<form method="get" class="filter-bar row g-2 align-items-end mb-3">
<div class="col-md-5"><label class="form-label">Search</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Title or reference number" /></div>
<div class="col-md-3"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var s in new[]{"Pending","In Progress","Resolved","Rejected"}){<option selected="@(ViewBag.Status == s)" value="@s">@s</option>}</select></div>
<div class="col-md-2"><label class="form-label">Priority</label><select name="priority" class="form-select"><option value="">All priorities</option>@foreach(var p in new[]{"Low","Normal","High","Urgent"}){<option selected="@(ViewBag.Priority == p)" value="@p">@p</option>}</select></div>
<div class="col-md-2 d-flex gap-2"><button class="btn btn-dark flex-grow-1">Filter</button><a class="btn btn-light" asp-action="Index">Reset</a></div>
</form>
@if (!Model.Any()) { <div class="empty-inline"><h5>No matching complaints</h5><p class="text-secondary">Try changing the filters or submit a new complaint.</p></div> }
else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Complaint</th><th>Category</th><th>Location</th><th>Priority</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td><strong>@c.Title</strong><br><small class="text-secondary">@c.ReferenceNumber</small></td><td>@c.Category?.Name</td><td>@c.Location</td><td><span class="priority priority-@c.Priority.ToLowerInvariant()">@c.Priority</span></td><td><span class="status status-@c.Status.ToLowerInvariant().Replace(" ", "-")">@c.Status</span></td><td>@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><a class="icon-link" asp-action="Details" asp-route-id="@c.Id">Open ↗</a></td></tr>}</tbody></table></div> }
</div>
