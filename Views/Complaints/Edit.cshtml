@model ComplaintFormViewModel
@{ ViewData["Title"] = "Edit complaint"; }
<div class="page-heading"><div><span class="eyebrow">UPDATE REQUEST</span><h1>Edit complaint</h1><p class="text-secondary mb-0">Make changes while the request is pending.</p></div><a asp-action="Index" class="btn btn-light">← Back</a></div>
<div class="form-card mt-4"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" />@await Html.PartialAsync("_ComplaintForm", Model)<button class="btn btn-accent btn-lg">Save changes</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
